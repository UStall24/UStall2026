<Application x:Class="UStallGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UStallGUI"
             xmlns:model="clr-namespace:UStallGUI.Model"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <model:BoolToBrushConverter x:Key="BoolToBrushConverter"
                                        TrueBrush="Yellow"
                                        FalseBrush="Gray" />
            <!-- other resources can go here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>