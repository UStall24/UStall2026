<UserControl x:Class="UStallGUI.View.TelemetryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:UStallGUI.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:TelemetryViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="400"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="AhrsBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFE2E8F0" />
            <Setter Property="BorderBrush" Value="#FF94A3B8" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasAttitude}" Value="True" />
                        <Condition Binding="{Binding AhrsHealthy}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFD4EDDA" />
                    <Setter Property="BorderBrush" Value="#FF28A745" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasAttitude}" Value="True" />
                        <Condition Binding="{Binding AhrsHealthy}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#FFFFF3CD" />
                    <Setter Property="BorderBrush" Value="#FFFFC107" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AhrsBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF334155" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasAttitude}" Value="True" />
                        <Condition Binding="{Binding AhrsHealthy}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FF155724" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasAttitude}" Value="True" />
                        <Condition Binding="{Binding AhrsHealthy}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FF856404" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF8FAFC" />
            <Setter Property="BorderBrush" Value="#FFCBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="3" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF64748B" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF0F172A" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <!-- Stream Controls & AHRS Health -->
            <GroupBox Header="AHRS IMU Stream" Margin="0,0,0,6">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource AhrsBadgeStyle}" Margin="0,0,0,6">
                        <TextBlock Text="{Binding AhrsStatusText}" Style="{StaticResource AhrsBadgeTextStyle}" />
                    </Border>

                    <Label Grid.Row="1" Grid.Column="0" Content="Rate:" VerticalAlignment="Center" Padding="2,0,6,0" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center"
                              ItemsSource="{Binding RateOptions}"
                              SelectedItem="{Binding SelectedRateHz, Mode=TwoWay}"
                              ItemStringFormat="{}{0} Hz" />
                    <Button Grid.Row="1" Grid.Column="2" Padding="10,3" MinWidth="86" VerticalAlignment="Center"
                            Content="{Binding StreamButtonText}"
                            Command="{Binding ToggleStreamCommand}" />
                </Grid>
            </GroupBox>

            <!-- Attitude (AHRS Euler Angles) -->
            <GroupBox Header="Attitude (AHRS)" Margin="0,0,0,6">
                <UniformGrid Columns="3" Margin="2">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="ROLL" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding RollText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="PITCH" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding PitchText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="YAW" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding YawText}" Style="{StaticResource MetricValueStyle}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </GroupBox>

            <!-- Gyroscope (AHRS Angular Rates) -->
            <GroupBox Header="Gyroscope (AHRS)" Margin="0,0,0,6">
                <UniformGrid Columns="3" Margin="2">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="GYRO X" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding GyroXText}" Style="{StaticResource MetricValueStyle}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="GYRO Y" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding GyroYText}" Style="{StaticResource MetricValueStyle}" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="GYRO Z" Style="{StaticResource MetricLabelStyle}" />
                            <TextBlock Text="{Binding GyroZText}" Style="{StaticResource MetricValueStyle}" FontSize="12" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </GroupBox>

            <!-- Accelerometer (AHRS Linear Acceleration) -->
            <GroupBox Header="Accelerometer (AHRS)" Margin="0,0,0,6">
                <StackPanel Margin="2">
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ACCEL X" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding AccelXText}" Style="{StaticResource MetricValueStyle}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ACCEL Y" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding AccelYText}" Style="{StaticResource MetricValueStyle}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="ACCEL Z" Style="{StaticResource MetricLabelStyle}" />
                                <TextBlock Text="{Binding AccelZText}" Style="{StaticResource MetricValueStyle}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <TextBlock Text="MAGNITUDE |a|" Style="{StaticResource MetricLabelStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AccelNormText}" Style="{StaticResource MetricValueStyle}" FontSize="12" Margin="0" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </StackPanel>
            </GroupBox>

            <!-- Footer Diagnostics -->
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" Foreground="#FF64748B"
                           Text="{Binding LastUpdateText, StringFormat='Updated: {0}'}" />
                <TextBlock Grid.Column="1" FontSize="11" Foreground="#FF64748B"
                           Text="{Binding FrameCount, StringFormat='Frames: {0}'}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
