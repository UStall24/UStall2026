<UserControl x:Class="UStallGUI.View.SetupHandlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UStallGUI.View" xmlns:viewmodel="clr-namespace:UStallGUI.ViewModel" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" d:DataContext="{d:DesignInstance Type=viewmodel:SetupHandlerViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="400" Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Margin="5" Header="Pixhawk Setup">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="COM Port:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Background="AliceBlue" Margin="5" IsReadOnly="True" VerticalContentAlignment="Center" Text="{Binding ComPort}" />
                <Button Grid.Column="2" Margin="5" Content="Connect CAN" Command="{Binding ConnectToPixhawk_Command}" />

                <Label Grid.Row="1" Content="Thrusters:" VerticalAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="1" Margin="5" Content="Arm" Command="{Binding ArmThrusters_Command}" />
                <Button Grid.Row="1" Grid.Column="2" Margin="5" Content="Disarm" Command="{Binding DisarmThrusters_Command}" />

                <Label Grid.Row="2" Content="Control Input:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="5" SelectedIndex="{Binding ControlType, Mode=TwoWay}">
                    <ComboBoxItem Content="Off" Tag="0" />
                    <ComboBoxItem Content="Manual" Tag="1" />
                    <ComboBoxItem Content="Controller" Tag="2" />
                </ComboBox>

                <Label Grid.Row="3" Content="Cycle Time [ms]:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Background="AliceBlue" VerticalContentAlignment="Center" Text="{Binding UpdateInterval}" />
                <Button Grid.Row="3" Grid.Column="2" Margin="5" Content="Apply" Command="{Binding ApplyUpdateInterval_Command}" />

                <Label Grid.Row="4" Content="Diagnostics:" VerticalAlignment="Center" />
                <Button Grid.Row="4" Grid.Column="1" Margin="5" Content="Reset Watchdog" Command="{Binding ResetWatchdog_Command}" />
                <Button Grid.Row="4" Grid.Column="2" Margin="5" Content="Health Ping" Command="{Binding HealthCommand}" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Margin="5" Header="Flight Mode &amp; Speed Limit">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="Flight Mode:" VerticalAlignment="Center"
                       ToolTip="MANUAL: Direct open-loop control (no attitude/depth hold). STABILIZE: Attitude hold. DEPTH_HOLD: Automatic depth + attitude hold." />
                <ComboBox Margin="5" Grid.Column="1"
                          SelectedIndex="{Binding SelectedFlightModeIndex, Mode=TwoWay}"
                          ToolTip="MANUAL: Direct open-loop control (no attitude/depth hold). STABILIZE: Attitude hold. DEPTH_HOLD: Automatic depth + attitude hold.">
                    <ComboBoxItem Content="MANUAL" />
                    <ComboBoxItem Content="STABILIZE" />
                    <ComboBoxItem Content="DEPTH_HOLD" />
                </ComboBox>

                <Label Grid.Row="1" Content="Speed Limit:"
                       VerticalAlignment="Center"
                       ToolTip="Global max thruster speed limit (0-100%) applied to all thruster outputs." />
                <Grid Grid.Row="1" Grid.Column="1" Margin="5" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False"
                            Value="{Binding MaxThrusterSpeedPercent, Mode=TwoWay}"
                            ToolTip="Global max thruster speed limit (0-100%) applied to all thruster outputs." />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="36" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding MaxThrusterSpeedPercent, StringFormat={}{0}%}" />
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
