<UserControl x:Class="UStallGUI.View.SetupHandlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UStallGUI.View" xmlns:viewmodel="clr-namespace:UStallGUI.ViewModel" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" d:DataContext="{d:DesignInstance Type=viewmodel:SetupHandlerViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="400" Background="White">
    <UserControl.Resources>
        <Style x:Key="ArmedBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFD4EDDA" />
            <Setter Property="BorderBrush" Value="#FF28A745" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Background" Value="#FFF8D7DA" />
                    <Setter Property="BorderBrush" Value="#FFDC3545" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ArmedBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#FF155724" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsArmed}" Value="True">
                    <Setter Property="Foreground" Value="#FF721C24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PidBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="AliceBlue" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="PidColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FF4A5568" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,2,2,1" />
        </Style>
        <Style x:Key="PidRowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,4,0" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <GroupBox Margin="0,0,0,5" Header="Pixhawk Setup">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Content="COM Port:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Background="AliceBlue" Margin="5" IsReadOnly="True" VerticalContentAlignment="Center" Text="{Binding ComPort}" />
                <Button Grid.Column="2" Margin="5" Content="Connect CAN" Command="{Binding ConnectToPixhawk_Command}" />

                <Label Grid.Row="1" Content="Status:" VerticalAlignment="Center" />
                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ArmedBadgeStyle}">
                    <TextBlock Text="{Binding ArmedStatusText}" Style="{StaticResource ArmedBadgeTextStyle}" />
                </Border>

                <Label Grid.Row="2" Content="Thrusters:" VerticalAlignment="Center" />
                <Button Grid.Row="2" Grid.Column="1" Margin="5" Content="Arm" Command="{Binding ArmThrusters_Command}" />
                <Button Grid.Row="2" Grid.Column="2" Margin="5" Content="Disarm" Command="{Binding DisarmThrusters_Command}" />

                <Label Grid.Row="3" Content="Control Input:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="3" Grid.Column="1" Margin="5" SelectedIndex="{Binding ControlType, Mode=TwoWay}">
                    <ComboBoxItem Content="Off" Tag="0" />
                    <ComboBoxItem Content="Active" Tag="1" />
                </ComboBox>

                <Label Grid.Row="4" Content="Cycle Time [ms]:" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Background="AliceBlue" VerticalContentAlignment="Center" Text="{Binding UpdateInterval}" />
                <Button Grid.Row="4" Grid.Column="2" Margin="5" Content="Apply" Command="{Binding ApplyUpdateInterval_Command}" />

                <Label Grid.Row="5" Content="Diagnostics:" VerticalAlignment="Center" />
                <Button Grid.Row="5" Grid.Column="1" Margin="5" Content="Reset Watchdog" Command="{Binding ResetWatchdog_Command}" />
                <Button Grid.Row="5" Grid.Column="2" Margin="5" Content="Health Ping" Command="{Binding HealthCommand}" />
            </Grid>
        </GroupBox>

        <GroupBox Margin="0,0,0,5" Header="Flight Mode &amp; Speed Limit">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Label Content="Flight Mode:" VerticalAlignment="Center"
                       ToolTip="MANUAL: Direct open-loop control (no attitude/depth hold). STABILIZE: Attitude hold. DEPTH_HOLD: Automatic depth + attitude hold." />
                <ComboBox Margin="5" Grid.Column="1"
                          SelectedIndex="{Binding SelectedFlightModeIndex, Mode=TwoWay}"
                          ToolTip="MANUAL: Direct open-loop control (no attitude/depth hold). STABILIZE: Attitude hold. DEPTH_HOLD: Automatic depth + attitude hold.">
                    <ComboBoxItem Content="MANUAL" />
                    <ComboBoxItem Content="STABILIZE" />
                    <ComboBoxItem Content="DEPTH_HOLD" />
                </ComboBox>

                <Label Grid.Row="1" Content="Speed Limit:"
                       VerticalAlignment="Center"
                       ToolTip="Global max thruster speed limit (0-100%) applied to all thruster outputs." />
                <Grid Grid.Row="1" Grid.Column="1" Margin="5" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" VerticalAlignment="Center"
                            Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False"
                            Value="{Binding MaxThrusterSpeedPercent, Mode=TwoWay}"
                            ToolTip="Global max thruster speed limit (0-100%) applied to all thruster outputs." />
                    <TextBlock Grid.Column="1" Margin="6,0,0,0" MinWidth="36" VerticalAlignment="Center" TextAlignment="Right"
                               Text="{Binding MaxThrusterSpeedPercent, StringFormat={}{0}%}" />
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Header="PID Tuning (Attitude &amp; Depth Hold)">
            <StackPanel Margin="4">
                <!-- Sync Controls -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Margin="2" Height="24" Content="Pull from Pixhawk"
                            Command="{Binding PullPids_Command}" IsEnabled="{Binding PidSync_Enabled}"
                            ToolTip="Read current Attitude &amp; Depth Hold PID parameters from Pixhawk." />
                    <Button Grid.Column="1" Margin="2" Height="24" Content="Apply to Pixhawk" FontWeight="SemiBold"
                            Command="{Binding ApplyPids_Command}" IsEnabled="{Binding PidSync_Enabled}"
                            ToolTip="Write and persist Attitude &amp; Depth Hold PID parameters to Pixhawk." />
                    <Button Grid.Column="2" Margin="2" Padding="8,0" Height="24" Content="Reset"
                            Command="{Binding ResetPidsToDefault_Command}"
                            ToolTip="Reset PID fields to ArduSub default values (click 'Apply to Pixhawk' to send)." />
                </Grid>

                <!-- Attitude PIDs (Roll / Pitch / Yaw) -->
                <TextBlock Text="Attitude PIDs (STABILIZE / ALT_HOLD)" FontWeight="SemiBold" FontSize="11"
                           Foreground="#FF2D3748" Margin="2,4,2,2" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Ang P" Style="{StaticResource PidColHeaderStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Rate P" Style="{StaticResource PidColHeaderStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Rate I" Style="{StaticResource PidColHeaderStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Rate D" Style="{StaticResource PidColHeaderStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="5" Text="IMAX" Style="{StaticResource PidColHeaderStyle}" />

                    <!-- Roll -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Roll:" Style="{StaticResource PidRowLabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PidBoxStyle}" Text="{Binding RollAngP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding RollAngP.ToolTipText}" />
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource PidBoxStyle}" Text="{Binding RollRateP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding RollRateP.ToolTipText}" />
                    <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource PidBoxStyle}" Text="{Binding RollRateI.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding RollRateI.ToolTipText}" />
                    <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource PidBoxStyle}" Text="{Binding RollRateD.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding RollRateD.ToolTipText}" />
                    <TextBox Grid.Row="1" Grid.Column="5" Style="{StaticResource PidBoxStyle}" Text="{Binding RollRateIMax.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding RollRateIMax.ToolTipText}" />

                    <!-- Pitch -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Pitch:" Style="{StaticResource PidRowLabelStyle}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PidBoxStyle}" Text="{Binding PitchAngP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding PitchAngP.ToolTipText}" />
                    <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource PidBoxStyle}" Text="{Binding PitchRateP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding PitchRateP.ToolTipText}" />
                    <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource PidBoxStyle}" Text="{Binding PitchRateI.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding PitchRateI.ToolTipText}" />
                    <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource PidBoxStyle}" Text="{Binding PitchRateD.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding PitchRateD.ToolTipText}" />
                    <TextBox Grid.Row="2" Grid.Column="5" Style="{StaticResource PidBoxStyle}" Text="{Binding PitchRateIMax.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding PitchRateIMax.ToolTipText}" />

                    <!-- Yaw -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Yaw:" Style="{StaticResource PidRowLabelStyle}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource PidBoxStyle}" Text="{Binding YawAngP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding YawAngP.ToolTipText}" />
                    <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource PidBoxStyle}" Text="{Binding YawRateP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding YawRateP.ToolTipText}" />
                    <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource PidBoxStyle}" Text="{Binding YawRateI.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding YawRateI.ToolTipText}" />
                    <TextBox Grid.Row="3" Grid.Column="4" Style="{StaticResource PidBoxStyle}" Text="{Binding YawRateD.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding YawRateD.ToolTipText}" />
                    <TextBox Grid.Row="3" Grid.Column="5" Style="{StaticResource PidBoxStyle}" Text="{Binding YawRateIMax.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding YawRateIMax.ToolTipText}" />
                </Grid>

                <Separator Margin="2,2,2,4" />

                <!-- Depth Hold PIDs (ALT_HOLD Z-Axis) -->
                <TextBlock Text="Depth Hold PIDs (ALT_HOLD)" FontWeight="SemiBold" FontSize="11"
                           Foreground="#FF2D3748" Margin="2,0,2,2" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="P" Style="{StaticResource PidColHeaderStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="I" Style="{StaticResource PidColHeaderStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="D" Style="{StaticResource PidColHeaderStyle}" />

                    <!-- Pos Z -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Pos Z:" Style="{StaticResource PidRowLabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PidBoxStyle}" Text="{Binding DepthPosP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DepthPosP.ToolTipText}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" />

                    <!-- Vel Z -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vel Z:" Style="{StaticResource PidRowLabelStyle}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PidBoxStyle}" Text="{Binding DepthVelP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DepthVelP.ToolTipText}" />
                    <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource PidBoxStyle}" Text="{Binding DepthVelI.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DepthVelI.ToolTipText}" />
                    <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource PidBoxStyle}" Text="{Binding DepthVelD.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DepthVelD.ToolTipText}" />

                    <!-- Accel Z -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Acc Z:" Style="{StaticResource PidRowLabelStyle}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource PidBoxStyle}" Text="{Binding DepthAccP.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DepthAccP.ToolTipText}" />
                    <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource PidBoxStyle}" Text="{Binding DepthAccI.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DepthAccI.ToolTipText}" />
                    <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource PidBoxStyle}" Text="{Binding DepthAccD.ValueText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding DepthAccD.ToolTipText}" />
                </Grid>
            </StackPanel>
        </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
