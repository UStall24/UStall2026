        <GroupBox Margin="5" Header="Joint 2 + 3" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Label Content="Position" Grid.Row="0" Grid.Column="0" />

                <Button Grid.Row="0" Grid.Column="1"
                        Content="J2 Step +"
                        Margin="10,5"
                        Command="{Binding GripperCommand}"
                        CommandParameter="J2_INC" />

                <Button Grid.Row="0" Grid.Column="2"
                        Content="J3 Step +"
                        Margin="10,5"
                        Command="{Binding GripperCommand}"
                        CommandParameter="J3_INC" />

                <Button Grid.Row="1" Grid.Column="1"
                        Content="J2 Step -"
                        Margin="10,5"
                        Command="{Binding GripperCommand}"
                        CommandParameter="J2_DEC" />

                <Button Grid.Row="1" Grid.Column="2"
                        Content="J3 Step -"
                        Margin="10,5"
                        Command="{Binding GripperCommand}"
                        CommandParameter="J2_DEC" />

                <Label Content="Speed" Grid.Row="2" Grid.Column="0" />
                <xctk:IntegerUpDown
                    Grid.Row="2"
                    Grid.Column="1"
                    Minimum="0"
                    Maximum="255"
                    Width="80"
                    Value="{Binding Joint2Speed, Mode=TwoWay}"
                    Increment="1"
                    HorizontalAlignment="Stretch"
                    Margin="5" />
                <Button Grid.Row="1" Grid.Column="2"
                Content="J3 Step -"
                Margin="10,5"
                Command="{Binding GripperCommand}"
                CommandParameter="J3_DEC" />
                <Label Content="Current Position J2" Grid.Row="3" Grid.Column="0" />
                <Label Content="{Binding ActualJoint2Position, FallbackValue='XXX'}" Grid.Row="3" Grid.Column="2" />

                <Label Content="Current Position J3" Grid.Row="4" Grid.Column="0" />
                <Label Content="{Binding ActualJoint3Position, FallbackValue='XXX'}" Grid.Row="4" Grid.Column="2" />
                <Label Content="Current Temperature" Grid.Row="5" Grid.Column="0" />
                <Label Content="{Binding Joint2and3Temperature, FallbackValue='XX °C'}" Grid.Row="5" Grid.Column="2" />

                <Label Content="Current Humidity" Grid.Row="6" Grid.Column="0" />
                <Label Content="{Binding Joint2and3Humidity, FallbackValue='XX %'}" Grid.Row="6" Grid.Column="2" />
            </Grid>
        </GroupBox>

        <Viewbox Stretch="Uniform" Grid.Row="4">
            <Image Source="/Media/MechProA.png" Margin="10" />
        </Viewbox>
    </Grid>
</UserControl>