<UserControl x:Class="UStallGUI.View.ControlParameterHandlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodel="clr-namespace:UStallGUI.ViewModel"
             d:DataContext="{d:DesignInstance Type=viewmodel:ControlParameterHandlerViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="420" Background="White">

    <UserControl.Resources>
        <Style x:Key="ThrusterCardStyle" TargetType="Border">
            <Setter Property="Width" Value="92" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="BorderBrush" Value="#FF2B6CB0" />
            <Setter Property="BorderThickness" Value="1.2" />
        </Style>

        <Style x:Key="DirToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FFD4EDDA" />
            <Setter Property="BorderBrush" Value="#FF28A745" />
            <Setter Property="Foreground" Value="#FF155724" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FFF8D7DA" />
                    <Setter Property="BorderBrush" Value="#FFDC3545" />
                    <Setter Property="Foreground" Value="#FF721C24" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <!-- Sync & Bench Test PWM Bar -->
            <GroupBox Header="Pixhawk Thruster Sync &amp; Bench Test" Margin="0,0,0,5">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="Pull from Pixhawk" Margin="2" Height="24"
                            Command="{Binding PullFromPixhawk_Command}" IsEnabled="{Binding ConfigSync_Enabled}" />
                    <Button Grid.Row="0" Grid.Column="1" Content="Apply to Pixhawk" Margin="2" Height="24" FontWeight="SemiBold"
                            Command="{Binding ApplyToPixhawk_Command}" IsEnabled="{Binding ConfigSync_Enabled}" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Reset" Margin="2" Padding="8,0" Height="24"
                            Command="{Binding ResetDefaults_Command}" />

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="2,4,2,0" VerticalAlignment="Center">
                        <TextBlock Text="Bench Test PWM (1100–1900 µs):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                        <TextBox Width="56" Height="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 Background="Aquamarine" Text="{Binding TestThrust}" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- ROV Diagram with Overlaid Thruster Config Cards -->
            <GroupBox Header="Thruster Layout (Port, Direction &amp; Test)" Margin="0,0,0,5">
                <Viewbox Stretch="Uniform" MaxHeight="380">
                    <Canvas Width="400" Height="400">
                        <Image Source="/ROV_Model.png" Width="400" Height="400" Stretch="Uniform" />

                        <!-- M1: Top Center (Vertical - Front Center) -->
                        <Border Canvas.Left="154" Canvas.Top="6" Style="{StaticResource ThrusterCardStyle}"
                                ToolTip="{Binding Thrusters[0].Description}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="M1 (V)" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Button Content="Test" FontSize="10" Padding="4,0" Height="18" DockPanel.Dock="Right"
                                            Command="{Binding TestMotor}" CommandParameter="0" IsEnabled="{Binding TestMotor_Enabled}" />
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding OutputPortOptions}" SelectedIndex="{Binding Thrusters[0].SelectedPortIndex}"
                                          Height="20" FontSize="10" Margin="0,0,0,2" />
                                <ToggleButton Style="{StaticResource DirToggleStyle}"
                                              IsChecked="{Binding Thrusters[0].IsReversed}"
                                              Content="{Binding Thrusters[0].DirectionLabel}" />
                            </StackPanel>
                        </Border>

                        <!-- M2: Upper Right (Horizontal - Front Right) -->
                        <Border Canvas.Left="304" Canvas.Top="78" Style="{StaticResource ThrusterCardStyle}"
                                ToolTip="{Binding Thrusters[1].Description}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="M2 (H)" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Button Content="Test" FontSize="10" Padding="4,0" Height="18" DockPanel.Dock="Right"
                                            Command="{Binding TestMotor}" CommandParameter="1" IsEnabled="{Binding TestMotor_Enabled}" />
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding OutputPortOptions}" SelectedIndex="{Binding Thrusters[1].SelectedPortIndex}"
                                          Height="20" FontSize="10" Margin="0,0,0,2" />
                                <ToggleButton Style="{StaticResource DirToggleStyle}"
                                              IsChecked="{Binding Thrusters[1].IsReversed}"
                                              Content="{Binding Thrusters[1].DirectionLabel}" />
                            </StackPanel>
                        </Border>

                        <!-- M3: Lower Right (Vertical - Rear Right) -->
                        <Border Canvas.Left="304" Canvas.Top="228" Style="{StaticResource ThrusterCardStyle}"
                                ToolTip="{Binding Thrusters[2].Description}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="M3 (V)" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Button Content="Test" FontSize="10" Padding="4,0" Height="18" DockPanel.Dock="Right"
                                            Command="{Binding TestMotor}" CommandParameter="2" IsEnabled="{Binding TestMotor_Enabled}" />
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding OutputPortOptions}" SelectedIndex="{Binding Thrusters[2].SelectedPortIndex}"
                                          Height="20" FontSize="10" Margin="0,0,0,2" />
                                <ToggleButton Style="{StaticResource DirToggleStyle}"
                                              IsChecked="{Binding Thrusters[2].IsReversed}"
                                              Content="{Binding Thrusters[2].DirectionLabel}" />
                            </StackPanel>
                        </Border>

                        <!-- M4: Bottom Center (Horizontal - Rear Center / Lateral) -->
                        <Border Canvas.Left="154" Canvas.Top="322" Style="{StaticResource ThrusterCardStyle}"
                                ToolTip="{Binding Thrusters[3].Description}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="M4 (H)" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Button Content="Test" FontSize="10" Padding="4,0" Height="18" DockPanel.Dock="Right"
                                            Command="{Binding TestMotor}" CommandParameter="3" IsEnabled="{Binding TestMotor_Enabled}" />
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding OutputPortOptions}" SelectedIndex="{Binding Thrusters[3].SelectedPortIndex}"
                                          Height="20" FontSize="10" Margin="0,0,0,2" />
                                <ToggleButton Style="{StaticResource DirToggleStyle}"
                                              IsChecked="{Binding Thrusters[3].IsReversed}"
                                              Content="{Binding Thrusters[3].DirectionLabel}" />
                            </StackPanel>
                        </Border>

                        <!-- M5: Lower Left (Vertical - Rear Left) -->
                        <Border Canvas.Left="4" Canvas.Top="228" Style="{StaticResource ThrusterCardStyle}"
                                ToolTip="{Binding Thrusters[4].Description}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="M5 (V)" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Button Content="Test" FontSize="10" Padding="4,0" Height="18" DockPanel.Dock="Right"
                                            Command="{Binding TestMotor}" CommandParameter="4" IsEnabled="{Binding TestMotor_Enabled}" />
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding OutputPortOptions}" SelectedIndex="{Binding Thrusters[4].SelectedPortIndex}"
                                          Height="20" FontSize="10" Margin="0,0,0,2" />
                                <ToggleButton Style="{StaticResource DirToggleStyle}"
                                              IsChecked="{Binding Thrusters[4].IsReversed}"
                                              Content="{Binding Thrusters[4].DirectionLabel}" />
                            </StackPanel>
                        </Border>

                        <!-- M6: Upper Left (Horizontal - Front Left) -->
                        <Border Canvas.Left="4" Canvas.Top="78" Style="{StaticResource ThrusterCardStyle}"
                                ToolTip="{Binding Thrusters[5].Description}">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                    <TextBlock Text="M6 (H)" FontWeight="Bold" FontSize="11" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                    <Button Content="Test" FontSize="10" Padding="4,0" Height="18" DockPanel.Dock="Right"
                                            Command="{Binding TestMotor}" CommandParameter="5" IsEnabled="{Binding TestMotor_Enabled}" />
                                </DockPanel>
                                <ComboBox ItemsSource="{Binding OutputPortOptions}" SelectedIndex="{Binding Thrusters[5].SelectedPortIndex}"
                                          Height="20" FontSize="10" Margin="0,0,0,2" />
                                <ToggleButton Style="{StaticResource DirToggleStyle}"
                                              IsChecked="{Binding Thrusters[5].IsReversed}"
                                              Content="{Binding Thrusters[5].DirectionLabel}" />
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Viewbox>
            </GroupBox>

            <!-- Per-Axis Gains (0..100%) -->
            <GroupBox Header="Per-Axis Gains (0-100%, Applied with 'Apply to Pixhawk')">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Forward:" VerticalAlignment="Center" />
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Value="{Binding GainForward}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding GainForward, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Lateral:" VerticalAlignment="Center" />
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Value="{Binding GainLateral}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding GainLateral, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Heave:" VerticalAlignment="Center" />
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Value="{Binding GainHeave}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding GainHeave, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Yaw:" VerticalAlignment="Center" />
                    <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Value="{Binding GainYaw}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding GainYaw, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Pitch:" VerticalAlignment="Center" />
                    <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Value="{Binding GainPitch}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding GainPitch, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Roll:" VerticalAlignment="Center" />
                    <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="False" Value="{Binding GainRoll}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding GainRoll, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
