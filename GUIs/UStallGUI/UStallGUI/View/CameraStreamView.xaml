<UserControl x:Class="UStallGUI.View.CameraStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UStallGUI.View" xmlns:viewmodel="clr-namespace:UStallGUI.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:CameraStreamViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <GroupBox Header="Camera Stream 1" Margin="5">
            <Image Stretch="Uniform" Source="{Binding CameraFrame1}" />
        </GroupBox>
        <GroupBox Grid.Column="1" Header="Camera Stream 2" Margin="5">
            <Image Stretch="Uniform" Source="{Binding CameraFrame2}" />
        </GroupBox>
        <GroupBox Grid.Column="0" Grid.Row="1" Header="Camera Stream 3" Margin="5">
            <Image Stretch="Uniform" Source="{Binding CameraFrame3}" />
        </GroupBox>

        <Button Grid.Column="1" Grid.Row="1" Content="Connect" Width="100" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,5" Command="{Binding StartStream_Command}" />

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Viewbox Stretch="Uniform">
                <Image Source="/ustall_logo.png" Margin="20" />
            </Viewbox>
            <Viewbox Stretch="Uniform" Grid.Column="1">
                <Image Source="/andritz_logo.png" />
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>