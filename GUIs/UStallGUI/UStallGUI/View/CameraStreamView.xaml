<UserControl x:Class="UStallGUI.View.CameraStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UStallGUI.View"
             xmlns:viewmodel="clr-namespace:UStallGUI.ViewModel"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:view="clr-namespace:UStallGUI.View"
             d:DataContext="{d:DesignInstance Type=viewmodel:CameraStreamViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800" Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--ping 192.168.0.3-->
        <!-- Camera Stream 1 -->
        <GroupBox Header="Camera Stream 1" Margin="5">
            <Grid Width="400" Height="300" ClipToBounds="True">

                <Image Source="{Binding CameraFrame1}"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding Rotation1}" />
                    </Image.RenderTransform>
                </Image>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
                    <Button ToolTip="Connect Camera 1" Width="40" Height="40" Margin="0,0,8,0" Visibility="Hidden"
                            Command="{Binding ConnectCamera1Command}">
                        <materialDesign:PackIcon Kind="Plug" Width="24" Height="24" />
                    </Button>
                    <ToggleButton ToolTip="Toggle Light 1" Width="40" Height="40" Visibility="Hidden"
                                  IsChecked="{Binding IsLight1On, Mode=TwoWay}">
                        <materialDesign:PackIcon Kind="Lightbulb" Width="24" Height="24"
                            Foreground="{Binding IsLight1On, Converter={StaticResource BoolToBrushConverter}}" />
                    </ToggleButton>
                </StackPanel>
                <Button ToolTip="Turn Camera"
                        Width="20"
                        Height="20"
                        Margin="0,0,8,8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding TurnCamera1Command}">
                    <materialDesign:PackIcon Kind="redo"
                             Width="12"
                             Height="12" />
                </Button>
            </Grid>
          
        </GroupBox>

        <!-- Camera Stream 2 -->
        <GroupBox Grid.Column="1" Header="Camera Stream 2" Margin="5">
            
            <Grid Width="400" Height="300" ClipToBounds="True">

                <Image Source="{Binding CameraFrame2}"
                Stretch="Uniform"
                RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding Rotation2}" />
                    </Image.RenderTransform>
                </Image>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
                    <Button ToolTip="Connect Camera 1" Width="40" Height="40" Margin="0,0,8,0" Visibility="Hidden"
            Command="{Binding ConnectCamera2Command}">
                        <materialDesign:PackIcon Kind="Plug" Width="24" Height="24" />
                    </Button>
                    <ToggleButton ToolTip="Toggle Light 1" Width="40" Height="40" Visibility="Hidden"
                  IsChecked="{Binding IsLight1On, Mode=TwoWay}">
                        <materialDesign:PackIcon Kind="Lightbulb" Width="24" Height="24"
            Foreground="{Binding IsLight1On, Converter={StaticResource BoolToBrushConverter}}" />
                    </ToggleButton>
                </StackPanel>
                <Button ToolTip="Turn Camera"
        Width="20"
        Height="20"
        Margin="0,0,8,8"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Command="{Binding TurnCamera2Command}">
                    <materialDesign:PackIcon Kind="redo"
             Width="12"
             Height="12" />
            </Button>
                
            </Grid>
        </GroupBox>

        <!-- Camera Stream 3 -->
        <GroupBox Grid.Column="0" Grid.Row="1" Header="Camera Stream 3" Margin="5">
            <Grid>
                <Image Stretch="Uniform" Source="{Binding CameraFrame3}" Margin="0,0,0,8" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding Rotation3}" />
                    </Image.RenderTransform>
                </Image>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
                    <Button ToolTip="Connect Camera 3" Width="40" Height="40" Margin="0,0,8,0" Visibility="Hidden"
                            Command="{Binding ConnectCamera3Command}">
                        <materialDesign:PackIcon Kind="Plug" Width="24" Height="24" />
                    </Button>
                    <ToggleButton ToolTip="Toggle Light 3" Width="40" Height="40" Visibility="Hidden"
                                  IsChecked="{Binding IsLight3On, Mode=TwoWay}">
                        <materialDesign:PackIcon Kind="Lightbulb" Width="24" Height="24"
                            Foreground="{Binding IsLight3On, Converter={StaticResource BoolToBrushConverter}}" />
                    </ToggleButton>
                </StackPanel>
                <Button ToolTip="Turn Camera"
        Width="20"
        Height="20"
        Margin="0,0,8,8"
        HorizontalAlignment="Right"
        VerticalAlignment="Top"
        Command="{Binding TurnCamera3Command}">
    <materialDesign:PackIcon Kind="redo"
             Width="12"
             Height="12" />
</Button>
            </Grid>
        </GroupBox>

        <!-- Logos (unchanged) -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- All Cameras Control Box -->
            <GroupBox Header="Camera Control" Margin="5" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,5">
                    <Button ToolTip="Connect All Cameras" Width="40" Height="40" Margin="0,0,8,0"
                            Command="{Binding ConnectAllCamerasCommand}">
                        <materialDesign:PackIcon Kind="Plug" Width="24" Height="24" />
                    </Button>
                    <ToggleButton ToolTip="Toggle All Lights" Width="40" Height="40" IsEnabled="False"
                                  IsChecked="{Binding AreAllLightsOn, Mode=TwoWay}"
                                  Command="{Binding ToggleAllLightsCommand}">
                        <materialDesign:PackIcon Kind="LightbulbGroup" Width="24" Height="24"
                            Foreground="{Binding AreAllLightsOn, Converter={StaticResource BoolToBrushConverter}}" />
                    </ToggleButton>

                    <Button ToolTip="Screenshot All Cameras" Width="40" Height="40" Margin="8,0,0,0"
                            Command="{Binding TakeAllCamerasScreenshotCommand}">
                        <materialDesign:PackIcon Kind="Camera" Width="24" Height="24" />
                    </Button>

                </StackPanel>
            </GroupBox>
            <view:QuickSetupView Grid.Row="1" Grid.RowSpan="2" />
            <!-- Logos (unchanged, now in Grid.Row=1) -->
            <Grid Grid.Row="2" Visibility="Hidden">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="10" />
                </Grid.RowDefinitions>
                <Viewbox Stretch="Uniform" Grid.Row="1">
                    <Image Source="/ustall_logo.png" Margin="20" />
                </Viewbox>
                <Viewbox Stretch="Uniform" Grid.Column="1" Grid.Row="1">
                    <Image Source="/andritz_logo.png" />
                </Viewbox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>