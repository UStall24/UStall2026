<Window x:Class="UStallGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UStallGUI"
        xmlns:viewmodel="clr-namespace:UStallGUI.ViewModel"
        xmlns:view="clr-namespace:UStallGUI.View"
        d:DataContext="{d:DesignInstance Type=viewmodel:MainWindowViewModel}"
        mc:Ignorable="d"
        Title="MainWindow"
        MinHeight="600" MinWidth="900">

    <Window.InputBindings>
        <!-- ... your key bindings ... -->
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="200" />
            <ColumnDefinition Width="5" />
            <!-- Splitter column -->
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Left content -->
        <view:CameraStreamView Grid.Row="0" Grid.Column="0" Margin="3,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Horizontal GridSplitter -->
        <GridSplitter Grid.Column="1" Grid.Row="0"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Width="5" Background="Gray" ShowsPreview="True" />

        <!-- Right content: Nested Grid for vertical resizing -->
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="200" />
                <RowDefinition Height="5" />
                <!-- Vertical splitter -->
                <RowDefinition Height="*" MinHeight="200" />
            </Grid.RowDefinitions>

            <!-- SetupHandlerView (top) -->
            <TabControl Grid.Row="0" Margin="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TabItem Header="Quick Setup" IsSelected="True">
                    <view:SetupHandlerView />
                </TabItem>
                <TabItem Header="Controller Settings">
                    <view:ControllerHandlerView />
                </TabItem>
                <TabItem Header="Driving Settings">
                    <view:ControlParameterHandlerView />
                </TabItem>
                <TabItem Header="Gripper Settings">
                    <view:AccessoryBoxSetupView />
                </TabItem>
            </TabControl>

            <!-- Vertical GridSplitter -->
            <GridSplitter Grid.Row="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          Height="5" Background="Gray" ShowsPreview="True" />

            <!-- Console (bottom) -->
            <GroupBox Grid.Row="2" Header="Console" Margin="3,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ScrollViewer Name="ConsoleScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ControlBoxConsoleText}" TextWrapping="Wrap" />
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</Window>